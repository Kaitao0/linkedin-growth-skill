# Copy this file to .env and fill in your keys.
# .env is in .gitignore — never commit it.

# Optional: Google Gemini API key for image generation via Nano Banana.
# Get one at https://aistudio.google.com/apikey
# If absent, the skill falls back to Pillow-based template generation.
GEMINI_API_KEY=

# Optional Phase 2: webhook URL of your own n8n instance for scheduled posting.
# Only set if you want to use scripts/post_to_n8n.py.
N8N_WEBHOOK_URL=
